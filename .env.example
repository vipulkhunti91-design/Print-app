# PrintQ OTP server configuration.
# Copy this file to .env and fill in a real SMS gateway to send live OTPs.
# Start the API server with: npm run otp-server
# The Vite dev server proxies /api to http://localhost:8787 by default.

# Port for server/otpServer.js (default 8787).
OTP_SERVER_PORT=8787

# Where Vite proxies /api requests (default http://localhost:8787).
OTP_SERVER_URL=http://localhost:8787

# Twilio SMS gateway (recommended). Get these from Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Alternative generic SMS gateway (POST JSON: { to, message, otp }).
SMS_API_URL=
SMS_API_KEY=

# Without a gateway the server logs the SMS and returns `devCode` to the app,
# so the 4-digit preview flow still works. WebOTP auto-read on Android also
# requires the SMS to end with "@<your-domain> #<otp>", which the server does.
