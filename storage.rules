rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User uploaded print documents: isolated under users/{userId}
    match /users/{userId}/{documentId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024 // 50MB max file limit
                   && request.resource.contentType.matches('application/pdf|application/vnd.*|image/.*');
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Public assets (app icons, branding)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}

